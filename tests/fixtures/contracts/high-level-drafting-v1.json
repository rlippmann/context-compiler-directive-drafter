{
  "id": "high-level-drafting-capability-v1",
  "kind": "api-capability-contract",
  "module": "context_compiler_directive_drafter",
  "capability": "high-level-drafting",
  "members": {
    "DraftResult": {
      "kind": "class",
      "constructor": {
        "signature": {
          "is_async": false,
          "params": [
            {"name": "source", "kind": "POSITIONAL_OR_KEYWORD", "has_default": false},
            {"name": "result", "kind": "POSITIONAL_OR_KEYWORD", "has_default": false}
          ]
        },
        "probes": [
          {"case": "missing_required", "args": [], "kwargs": {}, "expect": {"exception": "TypeError"}},
          {"case": "extra_argument", "args": ["source", "result", "extra"], "kwargs": {}, "expect": {"exception": "TypeError"}}
        ]
      }
    },
    "DirectiveDrafter": {
      "kind": "class",
      "constructor": {
        "signature": {
          "is_async": false,
          "params": [
            {"name": "fallback", "kind": "POSITIONAL_OR_KEYWORD", "has_default": true, "default": null},
            {"name": "fallback_source", "kind": "POSITIONAL_OR_KEYWORD", "has_default": true, "default": "fallback"},
            {"name": "async_fallback", "kind": "POSITIONAL_OR_KEYWORD", "has_default": true, "default": null},
            {"name": "async_fallback_source", "kind": "POSITIONAL_OR_KEYWORD", "has_default": true, "default": "fallback"}
          ]
        },
        "probes": [
          {"case": "extra_argument", "args": ["extra", "too", "many", "arguments", "here"], "kwargs": {}, "expect": {"exception": "TypeError"}},
          {"case": "wrong_type", "args": [], "kwargs": {"fallback_source": 1}, "expect": {"success": true}}
        ]
      },
        "public_members": {
          "mode": "exact",
          "members": {
            "fallback": {
              "kind": "property"
            },
            "async_fallback": {
              "kind": "property"
            },
            "configure_fallback": {
              "kind": "method",
              "signature": {
                "is_async": false,
                "params": [
                  {
                    "name": "self",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  },
                  {
                    "name": "fallback",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  },
                  {
                    "name": "source",
                    "kind": "KEYWORD_ONLY",
                    "has_default": false
                  }
                ]
              }
            },
            "clear_fallback": {
              "kind": "method",
              "signature": {
                "is_async": false,
                "params": [
                  {
                    "name": "self",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  }
                ]
              }
            },
            "configure_async_fallback": {
              "kind": "method",
              "signature": {
                "is_async": false,
                "params": [
                  {
                    "name": "self",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  },
                  {
                    "name": "async_fallback",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  },
                  {
                    "name": "source",
                    "kind": "KEYWORD_ONLY",
                    "has_default": false
                  }
                ]
              }
            },
            "clear_async_fallback": {
              "kind": "method",
              "signature": {
                "is_async": false,
                "params": [
                  {
                    "name": "self",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  }
                ]
              }
            },
            "draft_directive": {
              "kind": "method",
              "signature": {
                "is_async": false,
                "params": [
                {
                  "name": "self",
                  "kind": "POSITIONAL_OR_KEYWORD",
                  "has_default": false
                },
                {
                  "name": "user_input",
                  "kind": "POSITIONAL_OR_KEYWORD",
                  "has_default": false
                  }
                ]
              }
            },
            "async_draft_directive": {
              "kind": "method",
              "signature": {
                "is_async": true,
                "params": [
                  {
                    "name": "self",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  },
                  {
                    "name": "user_input",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  }
                ]
              }
            }
          }
        },
      "behavior_probes": [
        {
          "kind": "directive_drafter_draft",
          "user_input": "set premise concise replies",
          "expect_result": {
            "type": "object",
            "required_keys": [
              "source",
              "result"
            ],
            "properties": {
              "source": {
                "type": "string",
                "const": "heuristic"
              },
              "result": {
                "type": "object",
                  "required_keys": [
                    "text",
                    "kind",
                    "operands"
                  ],
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "kind": {
                    "type": "string",
                    "const": "set_premise"
                  },
                  "operands": {
                    "type": "object",
                    "required_keys": [
                      "value"
                    ],
                    "properties": {
                      "value": {
                        "type": "string",
                        "const": "concise replies"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "kind": "directive_drafter_draft",
          "user_input": "can you help with lunch?",
          "expect_result": {
            "type": "object",
            "required_keys": [
              "source",
              "result"
            ],
            "properties": {
              "source": {
                "type": "string",
                "const": "heuristic"
              },
              "result": {
                "type": "object",
                "required_keys": [
                  "reason"
                ],
                "properties": {
                  "reason": {
                    "type": "string",
                    "const": "reject.confident_non_directive"
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
