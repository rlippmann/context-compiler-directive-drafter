{
  "id": "high-level-drafting-capability-v1",
  "kind": "api-capability-contract",
  "module": "context_compiler_directive_drafter",
  "capability": "high-level-drafting",
  "members": {
    "DraftResult": {
      "kind": "class",
      "forbidden_members": [
        "outcome",
        "directive"
      ],
      "api_contract": {
        "concept": "immutable result envelope",
        "required_fields": ["source", "result"],
        "result_variants": ["canonical", "rejected", "unknown"]
      }
    },
    "DirectiveDrafter": {
      "kind": "class",
      "api_contract": {
        "constructor": {
          "supports": [
            "fallback",
            "fallback_source",
            "async_fallback",
            "async_fallback_source"
          ],
          "default_source": "fallback"
        },
        "members": {
          "fallback": {
            "kind": "configuration_status",
            "meaning": "whether a sync fallback is configured"
          },
          "async_fallback": {
            "kind": "configuration_status",
            "meaning": "whether an async fallback is configured"
          },
          "configure_fallback": {
            "kind": "operation",
            "inputs": ["fallback", "source"],
            "meaning": "install or replace the sync fallback"
          },
          "clear_fallback": {
            "kind": "operation",
            "inputs": [],
            "meaning": "remove the sync fallback"
          },
          "configure_async_fallback": {
            "kind": "operation",
            "inputs": ["async_fallback", "source"],
            "meaning": "install or replace the async fallback"
          },
          "clear_async_fallback": {
            "kind": "operation",
            "inputs": [],
            "meaning": "remove the async fallback"
          },
          "draft_directive": {
            "kind": "operation",
            "inputs": ["user_input"],
            "returns": "DraftResult",
            "async": false
          },
          "async_draft_directive": {
            "kind": "operation",
            "inputs": ["user_input"],
            "returns": "DraftResult",
            "async": true,
            "availability": "when the target language supports an async equivalent"
          }
        }
      },
      "behavior_probes": [
        {
          "kind": "directive_drafter_draft",
          "user_input": "set premise concise replies",
          "expect_result": {
            "type": "object",
            "required_keys": ["source", "result"],
            "properties": {
              "source": {"type": "string", "const": "heuristic"},
              "result": {
                "type": "object",
                "required_keys": ["text", "kind", "operands"],
                "properties": {
                  "text": {"type": "string", "const": "set premise concise replies"},
                  "kind": {"type": "string", "const": "set_premise"},
                  "operands": {
                    "type": "object",
                    "required_keys": ["value"],
                    "properties": {
                      "value": {"type": "string", "const": "concise replies"}
                    }
                  }
                }
              }
            }
          }
        },
        {
          "kind": "directive_drafter_draft",
          "user_input": "can you help with lunch?",
          "expect_result": {
            "type": "object",
            "required_keys": ["source", "result"],
            "properties": {
              "source": {"type": "string", "const": "heuristic"},
              "result": {
                "type": "object",
                "required_keys": ["reason"],
                "properties": {"reason": {"type": "string", "const": "non_directive"}}
              }
            }
          }
        },
        {
          "kind": "directive_drafter_draft",
          "user_input": "use",
          "expect_result": {
            "type": "object",
            "required_keys": ["source", "result"],
            "properties": {
              "source": {"type": "string", "const": "heuristic"},
              "result": {
                "type": "object",
                "required_keys": ["reason"],
                "properties": {"reason": {"type": "string", "const": "incomplete"}}
              }
            }
          }
        },
        {
          "kind": "directive_drafter_draft",
          "user_input": "use docker and prohibit peanuts",
          "expect_result": {
            "type": "object",
            "required_keys": ["source", "result"],
            "properties": {
              "source": {"type": "string", "const": "heuristic"},
              "result": {
                "type": "object",
                "required_keys": ["reason"],
                "properties": {"reason": {"type": "string", "const": "multiple_directives"}}
              }
            }
          }
        },
        {
          "kind": "directive_drafter_draft",
          "user_input": "Could we maybe use uv later",
          "expect_result": {
            "type": "object",
            "required_keys": ["source", "result"],
            "properties": {
              "source": {"type": "string", "const": "heuristic"},
              "result": {
                "type": "object",
                "required_keys": ["reason"],
                "properties": {"reason": {"type": "string", "const": "semantic_uncertainty"}}
              }
            }
          }
        },
        {
          "kind": "directive_drafter_fallback_routing",
          "mode": "sync",
          "user_input": "set premise concise replies",
          "heuristic_result": "canonical",
          "fallback_output": "canonical",
          "expect_fallback_calls": 0,
          "expect_source": "heuristic",
          "expect_result": {
            "type": "object",
            "required_keys": ["source", "result"],
            "properties": {
              "source": {"type": "string", "const": "heuristic"},
              "result": {"type": "object", "required_keys": ["kind"]}
            }
          }
        },
        {
          "kind": "directive_drafter_fallback_routing",
          "mode": "sync",
          "user_input": "can you help with lunch?",
          "heuristic_result": "rejected",
          "fallback_output": "canonical",
          "expect_fallback_calls": 0,
