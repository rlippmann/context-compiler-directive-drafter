{
  "id": "converter-prompt-capability-v1",
  "kind": "api-capability-contract",
  "module": "context_compiler_directive_drafter",
  "capability": "converter-prompt",
  "members": {
    "get_converter_prompt": {
      "kind": "callable",
      "signature": {
        "is_async": false,
        "params": []
      },
      "behavior_probes": [
        {
          "kind": "get_converter_prompt",
          "expect_substrings": [
            "You are a directive converter that drafts candidate",
            "Canonical directive forms:",
            "What premise vs policy means:",
            "Questions or discussion about directives",
            "Output: <NO_DIRECTIVE>"
          ],
          "reject_substrings": [
            "<NULL_OR_VALUE>",
            "<SET OF CURRENT POLICY ITEMS>",
            "Current compiler state:"
          ]
        }
      ]
    }
  }
}
