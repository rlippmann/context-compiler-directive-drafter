{
  "id": "fallback-integration-capability-v1",
  "kind": "api-capability-contract",
  "module": "context_compiler_directive_drafter.fallbacks",
  "capability": "native-fallback-integration",
  "members": {
    "DraftFallback": {
      "kind": "type_alias"
    },
    "AsyncDraftFallback": {
      "kind": "type_alias"
    },
    "FallbackProfile": {
      "kind": "class"
    },
    "get_fallback_profile": {
      "kind": "callable",
      "signature": {
        "is_async": false,
        "params": [
          {"name": "structured_output", "kind": "KEYWORD_ONLY", "has_default": true, "default": false},
          {"name": "allowed_directive_kinds", "kind": "KEYWORD_ONLY", "has_default": true, "default": null}
        ]
      }
    },
    "get_structured_output_schema": {
      "kind": "structured_schema_provider",
      "required_keys": ["type", "properties", "required", "additionalProperties"],
      "required_properties": ["classification", "output"],
      "classification_values": ["directive", "rejected"]
    },
    "NO_DIRECTIVE": {
      "kind": "abstention_sentinel",
      "value": "<NO_DIRECTIVE>"
    },
    "InvalidFallbackResponseError": {
      "kind": "invalid_response_signal"
    },
    "parse_structured_response": {
      "kind": "structured_response_parser",
      "probes": [
        {
          "input": "{\"classification\":\"rejected\",\"output\":null}",
          "expect": "rejected"
        },
        {
          "input": "{\"classification\":\"directive\",\"output\":null}",
          "expect": "invalid"
        },
        {
          "input": "not json",
          "expect": "invalid"
        }
      ]
    }
  }
}
