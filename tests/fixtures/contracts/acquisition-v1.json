{
  "id": "acquisition-capability-v1",
  "kind": "api-capability-contract",
  "module": "context_compiler_directive_drafter",
  "capability": "preprocessing-acquisition",
  "members": {
    "preprocess_heuristic": {
      "kind": "callable",
      "signature": {
        "is_async": false,
        "params": [
          {
            "name": "message",
            "kind": "POSITIONAL_OR_KEYWORD",
            "has_default": false
          }
        ]
      },
      "return_shape": {
        "any_of": [
          {
            "type": "object",
            "required_keys": [
              "outcome",
              "directive"
            ],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "directive"
                ]
              },
              "directive": {
                "type": "object",
                "required_keys": [
                  "text",
                  "kind",
                  "operands"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "operands": {
                    "type": "object"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required_keys": [
              "outcome",
              "directive",
              "reason"
            ],
            "properties": {
              "outcome": {
                "type": "string",
                "enum": [
                  "no_directive",
                  "unknown"
                ]
              },
              "directive": {
                "type": "null"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      },
      "shape_probes": [
        {
          "kwargs": {
            "message": "use docker"
          }
        },
        {
          "kwargs": {
            "message": "please help with lunch"
          }
        },
        {
          "kwargs": {
            "message": "use docker, actually prohibit docker"
          }
        }
      ]
    }
  }
}
