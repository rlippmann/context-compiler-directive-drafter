{
  "id": "public-api-surface-v1",
  "kind": "api-surface-contract",
  "module": "context_compiler_directive_drafter",
  "forbidden_exports": [],
  "exports": {
    "mode": "exact",
    "names": [
      "DraftResult",
      "DirectiveDrafter",
      "RejectedDirective",
      "RejectedReason",
      "UnknownDirective",
      "REASON_NON_DIRECTIVE",
      "REASON_INCOMPLETE",
      "REASON_MULTIPLE_DIRECTIVES",
      "REASON_INVALID_CANDIDATE"
    ],
    "members": {
      "DraftResult": {"kind": "class"},
      "DirectiveDrafter": {
        "kind": "class",
        "portable_members": {
          "mode": "exact",
          "members": {
            "fallback": {"kind": "configuration_status"},
            "async_fallback": {"kind": "configuration_status"},
            "configure_fallback": {"kind": "operation"},
            "clear_fallback": {"kind": "operation"},
            "configure_async_fallback": {"kind": "operation"},
            "clear_async_fallback": {"kind": "operation"},
            "draft_directive": {"kind": "operation", "async": false},
            "async_draft_directive": {"kind": "operation", "async": true}
          }
        }
      },
      "RejectedDirective": {"kind": "class"},
      "RejectedReason": {
        "kind": "type_alias",
        "api_contract": {
          "concept": "closed public rejection reason set",
          "values": [
            "non_directive",
            "incomplete",
            "multiple_directives",
            "invalid_candidate"
          ]
        }
      },
      "UnknownDirective": {"kind": "class"},
      "REASON_NON_DIRECTIVE": {"kind": "constant", "value": "non_directive"},
      "REASON_INCOMPLETE": {"kind": "constant", "value": "incomplete"},
      "REASON_MULTIPLE_DIRECTIVES": {
        "kind": "constant",
        "value": "multiple_directives"
      },
      "REASON_INVALID_CANDIDATE": {
        "kind": "constant",
        "value": "invalid_candidate"
      }
    }
  }
}
