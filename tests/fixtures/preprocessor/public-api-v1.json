{
  "id": "experimental-preprocessor-public-api-v1",
  "kind": "api-contract",
  "module": "context_compiler_directive_drafter",
  "forbidden_exports": [
    "PreprocessOutcome",
    "PreprocessResult"
  ],
  "exports": {
    "mode": "exact",
    "names": [
      "PREPROCESS_OUTCOME_DIRECTIVE",
      "PREPROCESS_OUTCOME_NO_DIRECTIVE",
      "PREPROCESS_OUTCOME_UNKNOWN",
      "PREPROCESSOR_NO_DIRECTIVE_SENTINEL",
      "DraftResult",
      "DirectiveDrafter",
      "parse_preprocessor_output",
      "preprocess_heuristic",
      "refine_directive",
      "render_prompt",
      "validate_preprocessor_output"
    ],
    "members": {
      "PREPROCESSOR_NO_DIRECTIVE_SENTINEL": {
      "kind": "constant",
      "value": "<NO_DIRECTIVE>"
      },
      "PREPROCESS_OUTCOME_DIRECTIVE": {
      "kind": "constant",
      "value": "directive"
      },
      "PREPROCESS_OUTCOME_NO_DIRECTIVE": {
      "kind": "constant",
      "value": "no_directive"
      },
      "PREPROCESS_OUTCOME_UNKNOWN": {
      "kind": "constant",
      "value": "unknown"
      },
      "DraftResult": {
        "kind": "class"
      },
      "DirectiveDrafter": {
        "kind": "class",
        "public_members": {
          "mode": "exact",
          "members": {
            "draft_directive": {
              "kind": "method",
              "signature": {
                "is_async": false,
                "params": [
                  {
                    "name": "self",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  },
                  {
                    "name": "user_input",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  },
                  {
                    "name": "engine",
                    "kind": "POSITIONAL_OR_KEYWORD",
                    "has_default": false
                  }
                ]
              }
            }
          }
        },
        "behavior_probes": [
          {
            "kind": "directive_drafter_draft",
            "engine_state": {
              "premise": null,
              "policies": {},
              "version": 2
            },
            "user_input": "set premise concise replies",
            "expect_result": {
              "type": "object",
              "required_keys": [
                "outcome",
                "directive"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "const": "directive"
                },
                "directive": {
                  "type": "string",
                  "const": "set premise concise replies"
                }
              }
            },
            "expect_engine_unchanged": true
          },
          {
            "kind": "directive_drafter_draft",
            "engine_state": {
              "premise": null,
              "policies": {},
              "version": 2
            },
            "user_input": "can you help with lunch?",
            "expect_result": {
              "type": "object",
              "required_keys": [
                "outcome",
                "directive"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "const": "no_directive"
                },
                "directive": {
                  "type": "null"
                }
              }
            },
            "expect_engine_unchanged": true
          },
          {
            "kind": "directive_drafter_draft",
            "engine_state": {
              "premise": "existing premise",
              "policies": {},
              "version": 2
            },
            "user_input": "set premise concise replies",
            "expect_result": {
              "type": "object",
              "required_keys": [
                "outcome",
                "directive"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "const": "directive"
                },
                "directive": {
                  "type": "string",
                  "const": "change premise to concise replies"
                }
              }
            },
            "expect_engine_unchanged": true
          }
        ]
      },
      "preprocess_heuristic": {
        "kind": "callable",
        "signature": {
          "is_async": false,
          "params": [
            {
              "name": "message",
              "kind": "POSITIONAL_OR_KEYWORD",
              "has_default": false
            }
          ]
        },
        "return_shape": {
          "any_of": [
            {
              "type": "object",
              "required_keys": [
                "outcome",
                "directive",
                "rule_id"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "directive"
                  ]
                },
                "directive": {
                  "type": "string"
                },
                "rule_id": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required_keys": [
                "outcome",
                "directive",
                "rule_id"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "no_directive",
                    "unknown"
                  ]
                },
                "directive": {
                  "type": "null"
                },
                "rule_id": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "shape_probes": [
          {
            "kwargs": {
              "message": "use docker"
            }
          },
          {
            "kwargs": {
              "message": "please help with lunch"
            }
          },
          {
            "kwargs": {
              "message": "use docker, actually prohibit docker"
            }
          }
        ]
      },
      "validate_preprocessor_output": {
        "kind": "callable",
        "signature": {
          "is_async": false,
          "params": [
            {
              "name": "raw_output",
              "kind": "POSITIONAL_OR_KEYWORD",
              "has_default": false
            }
          ]
        },
        "return_shape": {
          "any_of": [
            {
              "type": "object",
              "required_keys": [
                "classification",
                "output"
              ],
              "properties": {
                "classification": {
                  "type": "string",
                  "enum": [
                    "directive"
                  ]
                },
                "output": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required_keys": [
                "classification",
                "output"
              ],
              "properties": {
                "classification": {
                  "type": "string",
                  "enum": [
                    "no_directive",
                    "unknown"
                  ]
                },
                "output": {
                  "type": "null"
                }
              }
            }
          ]
        },
        "shape_probes": [
          {
            "kwargs": {
              "raw_output": "use docker"
            }
          },
          {
            "kwargs": {
              "raw_output": "<NO_DIRECTIVE>"
            }
          },
          {
            "kwargs": {
              "raw_output": {
                "classification": "directive",
                "output": "set premise concise replies"
              }
            }
          }
        ]
      },
      "parse_preprocessor_output": {
        "kind": "callable",
        "signature": {
          "is_async": false,
          "params": [
            {
              "name": "raw_output",
              "kind": "POSITIONAL_OR_KEYWORD",
              "has_default": false
            }
          ]
        },
        "return_shape": {
          "type": [
            "string",
            "null"
          ]
        },
        "shape_probes": [
          {
            "kwargs": {
              "raw_output": "use docker"
            }
          },
          {
            "kwargs": {
              "raw_output": "<NO_DIRECTIVE>"
            }
          },
          {
            "kwargs": {
              "raw_output": {
                "classification": "directive",
                "output": "set premise concise replies"
              }
            }
          }
        ]
      },
      "refine_directive": {
        "kind": "callable",
        "signature": {
          "is_async": false,
          "params": [
            {
              "name": "directive",
              "kind": "POSITIONAL_OR_KEYWORD",
              "has_default": false
            },
            {
              "name": "engine",
              "kind": "POSITIONAL_OR_KEYWORD",
              "has_default": false
            }
          ]
        }
      },
      "render_prompt": {
        "kind": "callable",
        "signature": {
          "is_async": false,
          "params": [
            {
              "name": "path",
              "kind": "POSITIONAL_OR_KEYWORD",
              "has_default": false
            },
            {
              "name": "premise",
              "kind": "POSITIONAL_OR_KEYWORD",
              "has_default": false
            },
            {
              "name": "policies",
              "kind": "POSITIONAL_OR_KEYWORD",
              "has_default": false
            }
          ]
        },
        "behavior_probes": [
          {
            "kind": "render_prompt_from_file",
            "path": "render-prompt-contract-probe.txt",
            "template": "source=file-template\npremise=<NULL_OR_VALUE>\npolicies=<SET OF CURRENT POLICY ITEMS>\npath-literal=render-prompt-contract-probe.txt\n",
            "premise": "concise replies",
            "policies": {
              "docker": "use"
            },
            "expect_result": "source=file-template\npremise=concise replies\npolicies=docker\npath-literal=render-prompt-contract-probe.txt",
            "reject_substrings": [
              "premise=<NULL_OR_VALUE>",
              "policies=<SET OF CURRENT POLICY ITEMS>"
            ]
          }
        ]
      }
    }
  }
}
